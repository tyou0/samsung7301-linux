<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone SourceAFIS matcher for the libfprint samsung7301 driver.

    The driver never links against SourceAFIS: it hands the raw native frames
    over a pipe to this helper and acts on the single result line the helper
    prints.  The helper therefore has to be a self contained executable that
    can be placed at a fixed, root owned path.

    Build and publish instructions: see README.md in this directory.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <!-- The published binary is installed as /usr/local/libexec/libfprint-samsung7301-afis -->
    <AssemblyName>libfprint-samsung7301-afis</AssemblyName>
    <RootNamespace>SourceAfisMatcher</RootNamespace>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- No ICU, no locale dependent behaviour, no satellite assemblies. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- NativeAOT: a single native executable, no shared runtime, no JIT. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>

    <!--
      No warning is suppressed here on purpose.  The SourceAFIS package pulls
      in ImageSharp and Dahomey.Cbor as transitive dependencies; neither is
      used on the matching path, but the dependency advisories and the AOT
      trim warnings they raise stay visible so that they can be reviewed.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SourceAFIS" Version="3.14.0" />
  </ItemGroup>

</Project>
